# or MAIL_PORT=465 with MAIL_AUTH=true and MAIL_SSL=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_FROM=payroll@peoplepay360.local
CHAT_RATE_LIMIT_PER_10_MIN=30
CHAT_MAX_TOOL_CALLS_PER_TURN=8
