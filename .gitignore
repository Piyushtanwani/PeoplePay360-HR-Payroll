backend/target/
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# Node / Vite
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.vite/
*.tsbuildinfo

# Python / MCP
mcp/.venv/
.venv/
venv/
**/__pycache__/
*.py[cod]
mcp/.pytest_cache/
.pytest_cache/
mcp/.mypy_cache/
mcp/.ruff_cache/
mcp/htmlcov/
.coverage

