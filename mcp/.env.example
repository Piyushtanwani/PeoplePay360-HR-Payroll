# Copy to mcp/.env and fill in. Everything here has a working default for local development
# except the gateway secret, which must match the backend's MCP_GATEWAY_SECRET exactly.

# Where this service listens. The backend reaches it at MCP_BASE_URL.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# The backend this service reads from. Every call it makes is a GET carrying the delegated token
# of whoever is chatting, so the assistant can never see more than that person could.
BACKEND_BASE_URL=http://localhost:8080
JWKS_URL=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=peoplepay360
JWT_AUDIENCE=mcp

# Shared secret proving a request came from the backend and not from a browser.
# MUST be identical to MCP_GATEWAY_SECRET in the backend environment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_GATEWAY_SECRET=replace-me-with-a-generated-secret

HTTP_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO

# dev allows an unverified token decode when the backend's key endpoint is briefly unreachable.
# Use prod anywhere real: it refuses a token it cannot verify.
APP_ENV=dev

# Answers a canned reply instead of calling a model, so the tool chain can be exercised with no
# provider configured. Turn this off once a real provider is set up in the admin area.
ENABLE_MOCK_LLM=true
