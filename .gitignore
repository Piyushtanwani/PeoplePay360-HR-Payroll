# ─────────────────────────────────────────────────────────────────────────────
# Secrets and credentials
# Nothing matching these may ever be committed. Commit only *.example templates
# containing placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# Environment files
.env
.env.*
*.env
!.env.example
!.env.*.example

# Local, developer-specific config overrides (never committed)
**/*-local.properties
**/*-local.yml
**/*-local.yaml
**/application-local.*
**/secrets.properties
**/secrets.json
**/secrets.yml
**/credentials.json
**/credentials.yml
**/service-account*.json
**/gcp-key*.json
**/aws-credentials*

# Keys, certificates and keystores
keys/
**/keys/
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.asc
*.gpg
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts

# Package-manager and CLI credential stores
.npmrc
.yarnrc
.netrc
.pypirc
.htpasswd

